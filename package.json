{
  "name": "graft",
  "displayName": "Graft — Collaborative Markdown Editor",
  "description": "WYSIWYG markdown editor with inline comments and suggestions, backed by GitHub",
  "version": "0.0.1",
  "publisher": "graft",
  "license": "MIT",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "graft.open",
        "title": "Graft: Open Document"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "vsce package",
    "dev:web": "vite",
    "build:web": "vite build",
    "preview:web": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@octokit/rest": "^21.0.0",
    "@replit/codemirror-vim": "^6.4.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-collaboration": "^3.31.4",
    "@tiptap/extension-collaboration-cursor": "^3.0.0",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-table-cell": "^3.31.4",
    "@tiptap/extension-table-header": "^3.31.4",
    "@tiptap/extension-table-row": "^3.31.4",
    "@tiptap/pm": "^2.10.0",
    "@tiptap/starter-kit": "^3.31.4",
    "codemirror": "^6.0.2",
    "tiptap-markdown": "^0.9.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.105.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "typescript": "^5.5.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
